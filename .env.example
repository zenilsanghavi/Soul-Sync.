# Supabase Configuration (Project Settings → API Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Local AI (Ollama). Set the model to whichever Qwen model you pulled, e.g. `ollama pull qwen3:4b-instruct`
# VITE_OLLAMA_URL=/ollama
VITE_OLLAMA_MODEL=qwen3:4b-instruct
